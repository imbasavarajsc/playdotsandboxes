---
---
<section class="game-controls glass-panel">
  <!-- Essential Action Buttons -->
  <div class="control-group action-buttons">
    <button id="new-game-btn" class="btn btn-primary" type="button" aria-label="Start New Game">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
        <path d="M21.5 2v6h-6M21.34 15.57a10 10 0 1 1-.57-8.38l5.67-5.67"></path>
      </svg>
      <span>New Game</span>
    </button>

    <button id="undo-btn" class="btn" title="Undo Last Move" type="button" aria-label="Undo Move">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <polyline points="9 14 4 9 9 4"></polyline>
        <path d="M20 20v-7a4 4 0 0 0-4-4H4"></path>
      </svg>
      <span>Undo</span>
    </button>

    <button id="redo-btn" class="btn" title="Redo Move" type="button" aria-label="Redo Move">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <polyline points="15 14 20 9 15 4"></polyline>
        <path d="M4 20v-7a4 4 0 0 1 4-4h12"></path>
      </svg>
      <span>Redo</span>
    </button>
  </div>

  <!-- Collapsible Game Settings (Collapsible on mobile, seamless inline on desktop) -->
  <details class="settings-details" id="settings-collapsible">
    <summary class="settings-summary" aria-label="Toggle Game Settings">
      <span class="summary-left">
        <svg class="gear-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="3"></circle>
          <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
        </svg>
        <span>Game Settings</span>
      </span>
      <span class="summary-arrow">
        <svg class="chevron-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="6 9 12 15 18 9"></polyline>
        </svg>
      </span>
    </summary>

    <div class="control-group option-selectors">
      <!-- Grid Size Selector -->
      <div class="setting-item">
        <span class="setting-label" id="grid-size-label">Grid Size</span>
        <div class="custom-dropdown" id="grid-size-dropdown" data-dropdown="grid-size">
          <button
            type="button"
            class="btn dropdown-trigger"
            id="grid-size-trigger"
            aria-haspopup="listbox"
            aria-expanded="false"
            aria-labelledby="grid-size-label grid-size-trigger"
          >
            <span class="dropdown-selected-text">4x4 (3x3 Boxes)</span>
            <svg class="dropdown-chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
          </button>
          <ul class="dropdown-menu" role="listbox" aria-labelledby="grid-size-label" tabindex="-1">
            <li class="dropdown-option" role="option" data-value="3" aria-selected="false">3x3 (2x2 Boxes)</li>
            <li class="dropdown-option selected" role="option" data-value="4" aria-selected="true">4x4 (3x3 Boxes)</li>
            <li class="dropdown-option" role="option" data-value="5" aria-selected="false">5x5 (4x4 Boxes)</li>
            <li class="dropdown-option" role="option" data-value="6" aria-selected="false">6x6 (5x5 Boxes)</li>
            <li class="dropdown-option" role="option" data-value="7" aria-selected="false">7x7 (6x6 Boxes)</li>
          </ul>
          <input type="hidden" id="grid-size-select" value="4" />
        </div>
      </div>

      <!-- AI Level Selector -->
      <div id="ai-level-container" class="setting-item">
        <span class="setting-label" id="ai-level-label">Computer Level</span>
        <div class="custom-dropdown" id="ai-level-dropdown" data-dropdown="ai-level">
          <button
            type="button"
            class="btn dropdown-trigger"
            id="ai-level-trigger"
            aria-haspopup="listbox"
            aria-expanded="false"
            aria-labelledby="ai-level-label ai-level-trigger"
          >
            <span class="dropdown-selected-text">⭐⭐ Medium</span>
            <svg class="dropdown-chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
          </button>
          <ul class="dropdown-menu" role="listbox" aria-labelledby="ai-level-label" tabindex="-1">
            <li class="dropdown-option" role="option" data-value="easy" aria-selected="false">⭐ Easy</li>
            <li class="dropdown-option selected" role="option" data-value="medium" aria-selected="true">⭐⭐ Medium</li>
            <li class="dropdown-option" role="option" data-value="hard" aria-selected="false">⭐⭐⭐ Hard</li>
          </ul>
          <input type="hidden" id="ai-level-select" value="medium" />
        </div>
      </div>

      <!-- Speed Timer Selector -->
      <div class="setting-item">
        <span class="setting-label" id="timer-label">Turn Timer</span>
        <div class="custom-dropdown" id="timer-dropdown" data-dropdown="timer">
          <button
            type="button"
            class="btn dropdown-trigger"
            id="timer-trigger"
            aria-haspopup="listbox"
            aria-expanded="false"
            aria-labelledby="timer-label timer-trigger"
          >
            <span class="dropdown-selected-text">15 Seconds</span>
            <svg class="dropdown-chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
          </button>
          <ul class="dropdown-menu" role="listbox" aria-labelledby="timer-label" tabindex="-1">
            <li class="dropdown-option" role="option" data-value="0" aria-selected="false">Off (Casual)</li>
            <li class="dropdown-option" role="option" data-value="10" aria-selected="false">10 Seconds</li>
            <li class="dropdown-option selected" role="option" data-value="15" aria-selected="true">15 Seconds</li>
            <li class="dropdown-option" role="option" data-value="30" aria-selected="false">30 Seconds</li>
          </ul>
          <input type="hidden" id="timer-select" value="15" />
        </div>
      </div>
    </div>
  </details>
</section>

<style>
  .game-controls {
    width: 100%;
    max-width: 1100px;
    margin: 16px;
    padding: 16px 24px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .control-group {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 12px;
  }

  .action-buttons {
    display: flex;
    gap: 12px;
    justify-content: center;
  }

  /* Game Settings Accordion */
  .settings-details {
    width: 100%;
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    background: rgba(255, 255, 255, 0.02);
    overflow: visible;
    transition: background var(--transition-fast);
  }

  .settings-details,
  .settings-details[open],
  .settings-details::details-content {
    overflow: visible;
  }

  .settings-summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 44px;
    padding: 10px 14px;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--text-muted);
    cursor: pointer;
    user-select: none;
    list-style: none;
    -webkit-tap-highlight-color: transparent;
  }

  .settings-summary::-webkit-details-marker {
    display: none;
  }

  .summary-left {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .summary-arrow {
    display: flex;
    align-items: center;
    transition: transform var(--transition-normal);
  }

  .settings-details[open] .summary-arrow {
    transform: rotate(180deg);
  }

  .settings-details[open] .settings-summary {
    color: var(--player1-color);
    border-bottom: 1px solid var(--border-color);
  }

  .option-selectors {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 16px;
    padding: 14px 16px;
    width: 100%;
    overflow: visible;
  }

  .setting-item {
    display: flex;
    align-items: center;
    gap: 8px;
    position: relative;
  }

  .setting-label {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text-muted);
    white-space: nowrap;
  }

  /* Custom Styled Dropdowns (Avoids native select flash & OS white backgrounds) */
  .custom-dropdown {
    position: relative;
    display: inline-block;
  }

  .dropdown-trigger {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    min-height: 44px;
    padding: 8px 14px;
    background: var(--bg-surface);
    color: var(--text-main);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    cursor: pointer;
    font-size: 0.875rem;
    font-weight: 500;
    transition: all var(--transition-fast);
    user-select: none;
    -webkit-tap-highlight-color: transparent;
  }

  .dropdown-trigger:hover {
    background: var(--bg-surface-hover);
    border-color: var(--border-glow);
  }

  .dropdown-trigger:focus-visible {
    outline: 2px solid var(--player1-color);
    outline-offset: 2px;
  }

  .custom-dropdown.open .dropdown-trigger {
    border-color: var(--player1-color);
    box-shadow: 0 0 12px var(--player1-glow);
    background: var(--bg-surface-hover);
  }

  .dropdown-selected-text {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .dropdown-chevron {
    transition: transform var(--transition-normal);
    color: var(--text-muted);
    flex-shrink: 0;
  }

  .custom-dropdown.open .dropdown-chevron {
    transform: rotate(180deg);
    color: var(--player1-color);
  }

  :global(.dropdown-menu) {
    position: fixed;
    min-width: 160px;
    width: max-content;
    max-height: 250px;
    overflow-y: auto;
    background: #1e293b;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: var(--radius-md);
    box-shadow: 0 14px 34px rgba(0, 0, 0, 0.65), 0 0 1px rgba(255, 255, 255, 0.2);
    padding: 6px;
    margin: 0;
    list-style: none;
    z-index: 99999;
    opacity: 0;
    visibility: hidden;
    transform: translateY(-6px) scale(0.98);
    transition: opacity 0.15s ease, transform 0.15s ease, visibility 0.15s;
    pointer-events: none;
    backdrop-filter: blur(16px);
  }

  :global(.dropdown-menu.open) {
    opacity: 1;
    visibility: visible;
    transform: translateY(0) scale(1);
    pointer-events: auto;
  }

  :global(.dropdown-option) {
    padding: 10px 14px;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--text-main);
    border-radius: var(--radius-sm);
    cursor: pointer;
    transition: all var(--transition-fast);
    display: flex;
    align-items: center;
    justify-content: space-between;
    white-space: nowrap;
    user-select: none;
  }

  :global(.dropdown-option:hover),
  :global(.dropdown-option.focused) {
    background: rgba(56, 189, 248, 0.15);
    color: var(--player1-color);
  }

  :global(.dropdown-option.selected) {
    background: rgba(56, 189, 248, 0.22);
    color: var(--player1-color);
    font-weight: 600;
  }

  @media (max-width: 768px) {
    .game-controls {
      padding: 10px 12px;
      margin: 6px 8px;
      width: calc(100% - 16px);
      gap: 10px;
    }

    .action-buttons {
      display: grid;
      grid-template-columns: 1.4fr 1fr 1fr;
      gap: 8px;
      width: 100%;
    }

    .action-buttons .btn {
      padding: 8px 10px;
      font-size: 0.875rem;
      min-height: 44px;
    }

    .option-selectors {
      display: flex;
      flex-direction: column;
      gap: 10px;
      padding: 12px;
      width: 100%;
    }

    .setting-item {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      width: 100%;
      gap: 4px;
    }

    .custom-dropdown {
      width: 100%;
    }

    .dropdown-trigger {
      width: 100%;
    }

    .dropdown-menu {
      width: 100%;
      max-width: 100%;
    }
  }

  @media (max-width: 360px) {
    .action-buttons {
      grid-template-columns: 1fr;
    }
  }
</style>

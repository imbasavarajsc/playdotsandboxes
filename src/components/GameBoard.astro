---
---
<div class="board-wrapper glass-panel">
  <!-- Notebook paper grid background (only visible in notebook theme) -->
  <div class="board-notebook-bg" aria-hidden="true"></div>
  <div class="svg-container">
    <svg id="game-svg" viewBox="0 0 600 600" preserveAspectRatio="xMidYMid meet" aria-label="Dots and Boxes Interactive Board">
      <!-- SVG dynamic elements generated by JS -->
      <g id="boxes-group"></g>
      <g id="lines-group"></g>
      <g id="dots-group"></g>
    </svg>
  </div>
</div>

<!-- Floating combo chain toast rendered near the board -->
<div id="combo-toast" role="status" aria-live="polite"></div>

<style>
  .board-wrapper {
    width: 100%;
    max-width: 580px;
    margin: 0 auto;
    padding: 24px;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    user-select: none;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
    contain: layout style;
    transition: opacity var(--transition-normal), box-shadow var(--transition-normal), border-color var(--transition-normal);
  }

  /* Shown while a 2-Player match is waiting on name entry */
  .board-wrapper.pending-start {
    opacity: 0.45;
    pointer-events: none;
  }

  /* Notebook paper background element */
  .board-notebook-bg {
    display: none;
    position: absolute;
    inset: 12px;
    border-radius: calc(var(--radius-lg) - 8px);
    pointer-events: none;
    z-index: 0;
    background-color: var(--board-bg);
    background-image:
      repeating-linear-gradient(
        0deg,
        var(--board-line-paper) 0px,
        var(--board-line-paper) 1px,
        transparent 1px,
        transparent 28px
      ),
      repeating-linear-gradient(
        90deg,
        var(--board-line-paper) 0px,
        var(--board-line-paper) 1px,
        transparent 1px,
        transparent 28px
      );
  }

  :global([data-theme="notebook"]) .board-notebook-bg {
    display: block;
  }

  :global([data-theme="notebook"]) .board-wrapper {
    background: rgba(253, 250, 243, 0.92);
    border-color: rgba(0, 0, 0, 0.12);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.1), inset 0 0 0 1px rgba(0,0,0,0.04);
  }

  :global([data-theme="light"]) .board-wrapper {
    background: rgba(255, 255, 255, 0.95);
    border-color: rgba(0, 0, 0, 0.08);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
  }

  .svg-container {
    width: 100%;
    aspect-ratio: 1 / 1;
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  #game-svg {
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  /* ── Line Styles ─────────────────────────────────────── */
  :global(.board-line) {
    cursor: pointer;
    transition: stroke var(--transition-fast), opacity var(--transition-fast), stroke-width var(--transition-fast);
  }

  :global(.board-line.empty) {
    stroke: var(--line-empty);
    stroke-linecap: round;
  }

  /* Ghost hover preview — luminous preview of would-be line */
  :global(.board-line.hovered) {
    stroke: var(--line-hover);
    stroke-width: 7px;
    opacity: 0.75;
    filter: drop-shadow(0 0 4px var(--player1-glow));
  }

  :global(.board-line.claimed-p1) {
    stroke: var(--player1-color);
    stroke-width: 8px;
    stroke-linecap: round;
  }

  :global(.board-line.claimed-p2) {
    stroke: var(--player2-color);
    stroke-width: 8px;
    stroke-linecap: round;
  }

  /* Draw-in animation for newly placed lines */
  :global(.board-line.line-draw-in) {
    animation: lineDrawAnim 0.22s ease-out forwards;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
  }

  :global(.board-line.last-move) {
    animation: pulseLine 1.6s ease-in-out infinite alternate;
  }

  @keyframes pulseLine {
    0%   { opacity: 0.75; }
    100% { opacity: 1; }
  }

  /* ── Box Styles ──────────────────────────────────────── */
  :global(.board-box) {
    transition: fill var(--transition-normal), opacity var(--transition-normal);
  }

  :global(.board-box.p1-box) {
    fill: var(--player1-bg);
  }

  :global(.board-box.p2-box) {
    fill: var(--player2-bg);
  }

  /* Bouncy pop-in when a box is newly captured */
  :global(.board-box.box-pop-in) {
    transform-origin: center;
    transform-box: fill-box;
    animation: boxPopAnim 0.38s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
  }

  :global(.box-label) {
    font-family: var(--font-family);
    font-weight: 800;
    font-size: 20px;
    text-anchor: middle;
    dominant-baseline: central;
    pointer-events: none;
    opacity: 0;
    transition: opacity var(--transition-normal);
  }

  /* Labels fade in after pop animation */
  :global(.box-label.label-visible) {
    opacity: 0.95;
  }

  :global(.box-label.p1-text) {
    fill: var(--player1-color);
  }

  :global(.box-label.p2-text) {
    fill: var(--player2-color);
  }

  /* ── Dot Styles ──────────────────────────────────────── */
  :global(.board-dot) {
    fill: var(--dot-color);
    transition: fill var(--transition-normal);
  }

  :global(.board-dot.active) {
    fill: var(--dot-active);
  }

  /* ── SVG keyframes ───────────────────────────────────── */
  @keyframes lineDrawAnim {
    from { stroke-dashoffset: 1; opacity: 0.4; }
    to   { stroke-dashoffset: 0; opacity: 1; }
  }

  @keyframes boxPopAnim {
    0%   { transform: scale(0.45); opacity: 0; }
    65%  { transform: scale(1.14); }
    100% { transform: scale(1);    opacity: 1; }
  }

  @media (max-width: 768px) {
    .board-wrapper {
      max-width: min(94vw, 440px);
      padding: 10px;
      margin: 4px auto;
    }
  }

  @media (max-width: 360px) {
    .board-wrapper {
      max-width: 96vw;
      padding: 6px;
      margin: 2px auto;
    }
  }
</style>

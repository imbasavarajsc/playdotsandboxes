---
---
<div id="online-modal" class="modal-overlay">
  <div class="modal-content online-card glass-panel">
    <div class="modal-header">
      <div class="header-title-row">
        <span class="online-icon">🌐</span>
        <h2 class="modal-title">Play Online with a Friend</h2>
      </div>
      <button id="close-online-btn" class="close-btn" aria-label="Close Online Modal">&times;</button>
    </div>

    <div class="online-body">
      <!-- Hosting View: Show Room Code & Shareable Link -->
      <div id="online-host-view" class="online-section">
        <p class="online-subtitle">
          Share this invite link with a friend. When they open it, you will automatically connect in real time!
        </p>

        <!-- Room Code Display -->
        <div class="room-code-badge-container">
          <span class="room-code-label">Room Code</span>
          <div class="room-code-display">
            <span id="online-room-code-val">-----</span>
          </div>
        </div>

        <!-- Shareable Link Input with Copy Button -->
        <div class="link-share-box">
          <label for="online-room-link-input" class="sr-only">Invite Link</label>
          <div class="input-with-button">
            <input
              type="text"
              id="online-room-link-input"
              class="room-link-input"
              readonly
              value="https://playdotsandboxes.com/?room=..."
              aria-label="Invite Link"
            />
            <button id="copy-online-link-btn" class="btn btn-primary" type="button">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
                <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
              </svg>
              <span id="copy-link-text">Copy Invite Link</span>
            </button>
          </div>
        </div>

        <!-- Social Share Buttons -->
        <div class="share-actions">
          <a
            id="whatsapp-share-btn"
            href="#"
            target="_blank"
            rel="noopener noreferrer"
            class="btn whatsapp-btn"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
              <path d="M17.472 14.382c-.301-.15-1.78-.878-2.056-.978-.276-.1-.476-.15-.676.15-.2.301-.776.978-.952 1.179-.175.2-.351.226-.652.075-.301-.151-1.27-.468-2.42-1.493-.895-.798-1.5-1.784-1.675-2.085-.175-.301-.019-.464.132-.614.136-.135.301-.351.452-.527.15-.175.2-.301.301-.501.1-.2.05-.376-.025-.527-.075-.15-.676-1.63-9.26-2.23-.244-.583-.493-.504-.676-.513l-.577-.01c-.2 0-.526.075-.802.376-.276.301-1.053 1.028-1.053 2.508 0 1.48 1.078 2.909 1.229 3.11.15.2 2.121 3.239 5.138 4.542.718.31 1.278.496 1.716.635.722.23 1.38.197 1.9.12.58-.087 1.78-.727 2.03-1.43.25-.702.25-1.304.175-1.43-.075-.125-.276-.2-.577-.35zM12 2a10 10 0 0 0-8.625 15.084L2 22l5.064-1.328A10 10 0 1 0 12 2zm0 18.2a8.16 8.16 0 0 1-4.167-1.144l-.299-.177-3.093.812.825-3.016-.194-.31A8.2 8.2 0 1 1 12 20.2z"/>
            </svg>
            <span>Share on WhatsApp</span>
          </a>
        </div>

        <!-- Real-time Status Indicator -->
        <div id="online-status-banner" class="status-banner waiting">
          <span class="status-pulse-dot"></span>
          <span id="online-status-desc">Waiting for friend to join...</span>
        </div>
      </div>

      <!-- Join by Code View (Collapsible Accordion) -->
      <details class="join-by-code-details" id="join-code-collapsible">
        <summary class="join-code-summary">
          <span>Have a Room Code? Join Match</span>
          <svg class="chevron-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <polyline points="6 9 12 15 18 9"></polyline>
          </svg>
        </summary>
        <div class="join-code-body">
          <input
            type="text"
            id="manual-room-input"
            class="manual-input"
            placeholder="e.g. 5K7MF"
            maxlength="8"
            autocomplete="off"
            aria-label="Enter Room Code"
          />
          <button id="manual-join-btn" class="btn btn-primary" type="button">
            Join Game
          </button>
        </div>
      </details>
    </div>
  </div>
</div>

<style>
  .online-card {
    width: 100%;
    max-width: 480px;
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 18px;
    background: #1e293b;
    border: 1px solid var(--border-color);
    box-shadow: var(--shadow-lg);
  }

  .header-title-row {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .online-icon {
    font-size: 1.5rem;
  }

  .modal-title {
    font-size: 1.35rem;
    font-weight: 800;
    color: var(--text-main);
    letter-spacing: -0.5px;
  }

  .online-body {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .online-subtitle {
    font-size: 0.9rem;
    line-height: 1.55;
    color: var(--text-muted);
  }

  .room-code-badge-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 6px;
    padding: 14px;
    background: rgba(15, 23, 42, 0.6);
    border: 1px dashed var(--border-glow);
    border-radius: var(--radius-md);
  }

  .room-code-label {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: var(--text-muted);
  }

  .room-code-display {
    font-family: var(--font-mono);
    font-size: 2.2rem;
    font-weight: 900;
    letter-spacing: 6px;
    color: var(--player1-color);
    text-shadow: 0 0 16px var(--player1-glow);
  }

  .link-share-box {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .input-with-button {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .room-link-input {
    flex: 1;
    min-width: 0;
    background: rgba(15, 23, 42, 0.8);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    padding: 10px 14px;
    font-size: 0.85rem;
    color: var(--text-main);
    font-family: var(--font-mono);
    outline: none;
    user-select: all;
  }

  .room-link-input:focus {
    border-color: var(--player1-color);
  }

  #copy-online-link-btn {
    white-space: nowrap;
    padding: 10px 16px;
    font-size: 0.875rem;
    gap: 6px;
  }

  .share-actions {
    display: flex;
    gap: 10px;
    width: 100%;
  }

  .whatsapp-btn {
    width: 100%;
    background: #25d366;
    color: #ffffff;
    font-weight: 700;
    font-size: 0.95rem;
    padding: 11px 16px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    border-radius: var(--radius-md);
    text-decoration: none;
    transition: opacity var(--transition-fast), transform var(--transition-fast);
  }

  .whatsapp-btn:hover {
    opacity: 0.92;
    transform: translateY(-1px);
  }

  .status-banner {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 12px 16px;
    background: rgba(56, 189, 248, 0.08);
    border: 1px solid var(--border-glow);
    border-radius: var(--radius-md);
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--player1-color);
  }

  .status-banner.connected {
    background: rgba(16, 185, 129, 0.12);
    border-color: rgba(16, 185, 129, 0.35);
    color: #34d399;
  }

  .status-banner.error {
    background: rgba(239, 68, 68, 0.12);
    border-color: rgba(239, 68, 68, 0.35);
    color: #f87171;
  }

  .status-pulse-dot {
    width: 10px;
    height: 10px;
    border-radius: var(--radius-full);
    background: currentColor;
    animation: pulse 1.6s infinite ease-in-out;
  }

  @keyframes pulse {
    0%, 100% {
      opacity: 0.3;
      transform: scale(0.85);
    }
    50% {
      opacity: 1;
      transform: scale(1.15);
    }
  }

  .join-by-code-details {
    border-top: 1px solid var(--border-color);
    padding-top: 14px;
    margin-top: 4px;
  }

  .join-code-summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text-muted);
    cursor: pointer;
    user-select: none;
  }

  .join-code-summary:hover {
    color: var(--text-main);
  }

  .join-code-body {
    display: flex;
    gap: 8px;
    margin-top: 12px;
  }

  .manual-input {
    flex: 1;
    background: rgba(15, 23, 42, 0.8);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    padding: 8px 12px;
    color: var(--text-main);
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 2px;
    font-weight: 700;
  }

  .manual-input:focus {
    outline: none;
    border-color: var(--player1-color);
  }

  @media (max-width: 480px) {
    .online-card {
      padding: 18px 14px;
    }

    .room-code-display {
      font-size: 1.8rem;
    }

    .input-with-button {
      flex-direction: column;
      align-items: stretch;
    }

    #copy-online-link-btn {
      width: 100%;
      justify-content: center;
    }
  }
</style>


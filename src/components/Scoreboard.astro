---
---
<section class="scoreboard glass-panel">
  <!-- Center Turn Status & Timer (on mobile, placed on top via order / grid area) -->
  <div class="turn-status-center">
    <div id="turn-timer" class="timer-badge">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
        <circle cx="12" cy="12" r="10"></circle>
        <polyline points="12 6 12 12 16 14"></polyline>
      </svg>
      <span id="timer-text">15s</span>
    </div>
    <div id="status-message" class="status-msg">Player 1's Turn</div>
    <div id="streak-banner" class="streak-badge hidden">🔥 Streak x<span id="streak-count">1</span></div>
  </div>

  <!-- Player 1 Card -->
  <div id="player1-card" class="player-card active-turn p1">
    <div id="p1-avatar" class="player-avatar p1-avatar">P1</div>
    <div class="player-info">
      <span id="p1-name" class="player-name">Player 1</span>
      <div class="player-score-row">
        <span id="p1-score" class="player-score">0</span>
        <span class="score-label">boxes</span>
      </div>
    </div>
    <div class="turn-indicator p1-indicator">TURN</div>
  </div>

  <!-- Player 2 / AI Card -->
  <div id="player2-card" class="player-card p2">
    <div class="turn-indicator p2-indicator">TURN</div>
    <div class="player-info align-right">
      <span id="p2-name" class="player-name">Computer</span>
      <div class="player-score-row">
        <span id="p2-score" class="player-score">0</span>
        <span class="score-label">boxes</span>
      </div>
    </div>
    <div id="p2-avatar" class="player-avatar p2-avatar">CPU</div>
  </div>
</section>

<style>
  .scoreboard {
    width: 100%;
    max-width: 1100px;
    margin: 16px;
    padding: 16px 24px;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    grid-template-areas: "p1 center p2";
    align-items: center;
    gap: 20px;
  }

  .turn-status-center {
    grid-area: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 6px;
    text-align: center;
  }

  #player1-card {
    grid-area: p1;
  }

  #player2-card {
    grid-area: p2;
  }

  .player-card {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 12px 18px;
    background: rgba(255, 255, 255, 0.03);
    border: 2px solid transparent;
    border-radius: var(--radius-md);
    transition: all var(--transition-bounce);
    position: relative;
    overflow: hidden;
  }

  .player-card.active-turn.p1 {
    border-color: var(--player1-color);
    box-shadow: 0 0 20px var(--player1-glow);
    background: var(--player1-bg);
  }

  .player-card.active-turn.p2 {
    border-color: var(--player2-color);
    box-shadow: 0 0 20px var(--player2-glow);
    background: var(--player2-bg);
  }

  .player-avatar {
    width: 44px;
    height: 44px;
    min-width: 44px;
    border-radius: var(--radius-full);
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 800;
    font-size: 1.1rem;
  }

  .p1-avatar {
    background: var(--player1-color);
    color: #000;
    box-shadow: 0 0 10px var(--player1-glow);
  }

  .p2-avatar {
    background: var(--player2-color);
    color: #fff;
    box-shadow: 0 0 10px var(--player2-glow);
  }

  .player-info {
    display: flex;
    flex-direction: column;
    min-width: 0;
    flex: 1;
  }

  .align-right {
    align-items: flex-end;
    text-align: right;
  }

  .player-name {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--text-muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 100%;
  }

  .editable-name {
    cursor: pointer;
    border-bottom: 1px dashed rgba(255, 255, 255, 0.3);
    padding-bottom: 1px;
    outline: none;
    transition: border-color var(--transition-fast), color var(--transition-fast);
  }

  .editable-name:hover, .editable-name:focus {
    border-bottom-color: var(--player1-color);
    color: var(--text-main);
  }

  .player-score-row {
    display: flex;
    align-items: baseline;
    gap: 6px;
  }

  .player-score {
    font-size: 1.8rem;
    font-weight: 900;
    color: var(--text-main);
    line-height: 1;
  }

  .score-label {
    font-size: 0.75rem;
    color: var(--text-faint);
  }

  .turn-indicator {
    display: none;
    font-size: 0.65rem;
    font-weight: 800;
    padding: 3px 8px;
    border-radius: 4px;
    letter-spacing: 0.5px;
  }

  .active-turn .turn-indicator {
    display: block;
    animation: popIn var(--transition-bounce);
  }

  .p1-indicator {
    background: var(--player1-color);
    color: #000;
  }

  .p2-indicator {
    background: var(--player2-color);
    color: #fff;
  }

  .timer-badge {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 4px 12px;
    background: rgba(255, 255, 255, 0.08);
    border-radius: var(--radius-full);
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--accent-gold);
  }

  .status-msg {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--text-main);
    min-height: 1.3em;
  }

  .streak-badge {
    font-size: 0.75rem;
    font-weight: 800;
    padding: 2px 8px;
    background: linear-gradient(135deg, #f59e0b, #ef4444);
    color: #ffffff;
    border-radius: var(--radius-full);
    animation: popIn var(--transition-bounce);
  }

  .hidden {
    display: none !important;
  }

  @media (max-width: 768px) {
    .scoreboard {
      grid-template-columns: 1fr 1fr;
      grid-template-areas:
        "center center"
        "p1 p2";
      gap: 8px;
      margin: 6px 8px;
      padding: 10px 12px;
      width: calc(100% - 16px);
    }

    .turn-status-center {
      margin-bottom: 2px;
      gap: 4px;
    }

    .status-msg {
      font-size: 0.875rem;
    }

    .player-card {
      padding: 8px 10px;
      gap: 8px;
    }

    .player-avatar {
      width: 36px;
      height: 36px;
      min-width: 36px;
      font-size: 0.9rem;
    }

    .player-score {
      font-size: 1.4rem;
    }

    .player-name {
      font-size: 0.8rem;
    }

    .turn-indicator {
      display: none !important;
    }
  }

  @media (max-width: 360px) {
    .scoreboard {
      padding: 8px;
      gap: 6px;
    }
    
    .player-card {
      padding: 6px 8px;
      gap: 6px;
    }

    .player-avatar {
      width: 32px;
      height: 32px;
      min-width: 32px;
      font-size: 0.8rem;
    }

    .player-score {
      font-size: 1.25rem;
    }
  }
</style>

---
---
<div id="player-names-modal" class="names-panel">
  <div class="player-names-card">
    <div class="modal-header">
      <h2 id="names-modal-title" class="modal-title">⚔️ 2 Player Mode</h2>
    </div>

    <p id="names-modal-desc" class="modal-description">Enter names for both players to start the match.</p>

    <div class="name-inputs-container">
      <div class="input-group p1-input-group">
        <label for="p1-name-input">
          <span class="player-dot p1-dot"></span> Player 1 Name
        </label>
        <input type="text" id="p1-name-input" class="name-input" placeholder="Player 1" maxlength="16" value="Player 1" autocomplete="off" />
      </div>

      <div id="p2-name-group" class="input-group p2-input-group">
        <label for="p2-name-input">
          <span class="player-dot p2-dot"></span> Player 2 Name
        </label>
        <input type="text" id="p2-name-input" class="name-input p2" placeholder="Player 2" maxlength="16" value="Player 2" autocomplete="off" />
      </div>
    </div>

    <div class="modal-footer">
      <button id="start-2p-btn" class="btn btn-primary btn-lg">
        Start Battle 🚀
      </button>
    </div>
  </div>
</div>

<style>
  /* Anchored dropdown panel (portaled to document.body, positioned via JS
     near the mode selector) — NOT a full-screen blocking overlay. Only
     ever shown for 2-Player mode, before the match starts. */
  .names-panel {
    position: fixed;
    width: 300px;
    max-width: calc(100vw - 24px);
    z-index: 99999;
    opacity: 0;
    visibility: hidden;
    transform: translateY(-6px) scale(0.98);
    transition: opacity 0.15s ease, transform 0.15s ease, visibility 0.15s;
    pointer-events: none;
  }

  .names-panel.open {
    opacity: 1;
    visibility: visible;
    transform: translateY(0) scale(1);
    pointer-events: auto;
  }

  .player-names-card {
    display: flex;
    flex-direction: column;
    gap: 18px;
    background: #1e293b;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: var(--radius-md);
    box-shadow: 0 14px 34px rgba(0, 0, 0, 0.65), 0 0 1px rgba(255, 255, 255, 0.2);
    backdrop-filter: blur(16px);
    padding: 18px;
  }

  .modal-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .modal-title {
    font-size: 1.1rem;
    font-weight: 800;
  }

  .modal-description {
    font-size: 0.85rem;
    color: var(--text-muted);
    line-height: 1.5;
  }

  .name-inputs-container {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .input-group {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .input-group label {
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--text-main);
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .player-dot {
    width: 10px;
    height: 10px;
    border-radius: var(--radius-full);
    display: inline-block;
  }

  .p1-dot {
    background: var(--player1-color);
  }

  .p2-dot {
    background: var(--player2-color);
  }

  .name-input {
    width: 100%;
    padding: 12px 16px;
    font-size: 1rem;
    font-weight: 600;
    font-family: inherit;
    border-radius: var(--radius-md);
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid var(--border-color);
    color: var(--text-main);
    outline: none;
    transition: border-color var(--transition-normal), box-shadow var(--transition-normal);
    box-sizing: border-box;
  }

  .name-input:focus {
    border-color: var(--player1-color);
    box-shadow: 0 0 12px var(--player1-glow);
  }

  .name-input.p2:focus {
    border-color: var(--player2-color);
    box-shadow: 0 0 12px var(--player2-glow);
  }

  .btn-lg {
    width: 100%;
    padding: 12px;
    font-size: 1.05rem;
  }
</style>

---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Scoreboard from '../components/Scoreboard.astro';
import GameBoard from '../components/GameBoard.astro';
import GameControls from '../components/GameControls.astro';
import VictoryModal from '../components/VictoryModal.astro';
import TutorialModal from '../components/TutorialModal.astro';
import StatsModal from '../components/StatsModal.astro';
import PlayerNamesModal from '../components/PlayerNamesModal.astro';
import OnlineModal from '../components/OnlineModal.astro';
import Footer from '../components/Footer.astro';

const indexSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["VideoGame", "SoftwareApplication"],
      "name": "Dots and Boxes Online",
      "alternateName": ["BoxBattle", "Dots and Boxes Game", "Play Dots and Boxes"],
      "description": "Play the classic Dots and Boxes strategy game online for free. Enjoy 2-player mode, challenge smart AI opponents, customize grid sizes from 3x3 to 7x7, track statistics, and play instantly in your browser with no download.",
      "url": "https://playdotsandboxes.com",
      "image": "https://playdotsandboxes.com/og-image.svg",
      "applicationCategory": "GameApplication",
      "gamePlatform": ["Web Browser", "Desktop", "Mobile", "Tablet"],
      "operatingSystem": "Any",
      "genre": ["Strategy", "Board Game", "Puzzle"],
      "numberOfPlayers": {
        "@type": "QuantitativeValue",
        "minValue": 1,
        "maxValue": 2
      },
      "playMode": ["SinglePlayer", "MultiPlayer"],
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock"
      },
      "author": {
        "@type": "Organization",
        "name": "BoxBattle",
        "url": "https://playdotsandboxes.com"
      }
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "How do you play Dots and Boxes?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Players take turns connecting two adjacent dots with a horizontal or vertical line. When a player draws the fourth line that completes a 1x1 box, they capture that box, earn one point, and must take an immediate bonus turn. The game ends when all lines are drawn, and the player with the most boxes wins."
          }
        },
        {
          "@type": "Question",
          "name": "How do you win Dots and Boxes every time?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "To consistently win at Dots and Boxes, master the Double-Cross strategy. When presented with a chain of boxes, capture all but the last two boxes, then forfeit those two boxes by drawing an internal dividing line. This forces your opponent to take the final two boxes and open the next chain for you, giving you control over the remaining board."
          }
        },
        {
          "@type": "Question",
          "name": "What is the best strategy for a 6x6 Dots and Boxes grid?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A 6x6 dot grid creates 25 boxes (5x5), which is an odd number of boxes meaning ties are impossible. The first player to capture 13 boxes wins. The winning strategy focuses on parity control, counting the number of long chains (3+ boxes), and using sacrifices to ensure you sweep the final, largest chain on the board."
          }
        },
        {
          "@type": "Question",
          "name": "Can I play Dots and Boxes online with 2 players for free?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes! BoxBattle lets you play Dots and Boxes online completely free with 2 players in local pass-and-play mode, or challenge smart AI opponents across 3 difficulty levels with zero ads, downloads, or registration."
          }
        }
      ]
    }
  ]
};
---

<Layout
	title="Dots and Boxes Game Online - Play Free 2 Player Strategy Game"
	description="Play the classic dots and boxes game online for free! Enjoy 2-player mode, challenge AI opponents, customize grid sizes, track stats, and learn winning strategies. No download required - play instantly in your browser."
	url="https://playdotsandboxes.com"
	schema={indexSchema}
>
	<main class="game-layout">
		<Navbar />
		<Scoreboard />
		<GameBoard />
		<GameControls />

		<!-- SEO Informational & Keyword Guide Section -->
		<section class="seo-guide-container">
			<article class="seo-card glass-panel">
				<header class="seo-header">
					<div class="badge">Game Guide & Overview</div>
					<h2>How to Play Dots and Boxes (2 Player & AI Rules)</h2>
					<p class="seo-subtitle">
						Master the timeless classic paper-and-pencil game right in your browser. Whether challenging a friend in 2-player pass-and-play or sharpening your skills against smart AI opponents, here is everything you need to know.
					</p>
				</header>

				<div class="seo-grid">
					<div class="seo-step-card">
						<div class="step-badge">1</div>
						<h3>Connect Adjacent Dots</h3>
						<p>Players take turns drawing one horizontal or vertical line between two unlinked dots. Diagonal lines are prohibited.</p>
					</div>

					<div class="seo-step-card">
						<div class="step-badge">2</div>
						<h3>Complete 1x1 Boxes</h3>
						<p>When you place the 4th side around any 1x1 box, you claim it, earn 1 point, and receive a mandatory extra turn to draw again.</p>
					</div>

					<div class="seo-step-card">
						<div class="step-badge">3</div>
						<h3>Double-Cross & Win</h3>
						<p>Avoid placing the 3rd side on any box early. Force your opponent to open chains, execute the double-cross sacrifice, and claim the victory!</p>
					</div>
				</div>

				<div class="seo-quick-links">
					<a href="/how-to-play" class="btn btn-outline">📖 Full Step-by-Step Tutorial</a>
					<a href="/rules" class="btn btn-outline">📋 Official Game Regulations</a>
					<a href="/strategy" class="btn btn-outline">🧠 Winning Strategy & 6x6 Guide</a>
				</div>
			</article>

			<article class="seo-card glass-panel">
				<header class="seo-header">
					<div class="badge">About the Platform</div>
					<h2>About Dots and Boxes Online (BoxBattle)</h2>
					<p class="seo-subtitle">
						Invented in 1889 by French mathematician Édouard Lucas under the name <em>La Pipopipette</em>, Dots and Boxes has entertained generations. BoxBattle modernizes this strategy game for web browsers with responsive controls, zero downloads, and complete privacy.
					</p>
				</header>

				<div class="features-summary-grid">
					<div class="feature-box">
						<span class="feat-icon">👥</span>
						<h4>2 Player & AI Modes</h4>
						<p>Play locally with a friend on mobile, tablet, or PC, or test your skills against Easy, Medium, and Hard AI engines.</p>
					</div>
					<div class="feature-box">
						<span class="feat-icon">📐</span>
						<h4>Multiple Grid Sizes</h4>
						<p>Choose from fast 3x3 dot sprints to deep 5x5, 6x6, and 7x7 combinatorial matches with full chain parity dynamics.</p>
					</div>
					<div class="feature-box">
						<span class="feat-icon">🔒</span>
						<h4>100% Free & Private</h4>
						<p>No account creation, no intrusive tracking, and no downloads required. Your game statistics stay safely on your local device.</p>
					</div>
					<div class="feature-box">
						<span class="feat-icon">⚡</span>
						<h4>Audio & Tactile Effects</h4>
						<p>Enjoy procedural sound effects, haptic vibration support on mobile devices, and celebratory victory animations.</p>
					</div>
				</div>

				<div class="seo-faq-section">
					<h3>Frequently Asked Questions</h3>
					<div class="faq-accordion">
						<details class="faq-item">
							<summary>How do you win Dots and Boxes every time?</summary>
							<p>The secret is mastering the <strong>Double-Cross</strong>. When given a chain of boxes, capture all but the final two boxes, then forfeit those two boxes by drawing an internal dividing line. This forces your opponent to take the final two boxes and break open the next chain for you, giving you control of the board.</p>
						</details>
						<details class="faq-item">
							<summary>What is the winning strategy for 6x6 and 5x5 grids?</summary>
							<p>A 6x6 dot grid contains 25 boxes (an odd number), meaning ties are impossible and the first to reach 13 boxes wins. Success on 6x6 grids relies on parity control over long chains (3+ boxes) and making strategic 4-box loop sacrifices to sweep the largest remaining corridors.</p>
						</details>
						<details class="faq-item">
							<summary>Can I play with 2 players locally on the same screen?</summary>
							<p>Yes! Switch the mode selector in the top bar to <strong>2 Player</strong> to play local pass-and-play with custom player names and colors on any smartphone, tablet, laptop, or desktop.</p>
						</details>
					</div>
				</div>
			</article>
		</section>
	</main>
	<Footer />

	<!-- Modals -->
	<VictoryModal />
	<TutorialModal />
	<StatsModal />
	<PlayerNamesModal />
	<OnlineModal />
</Layout>

<script>
	import { initApp } from '../scripts/appController';

	document.addEventListener('DOMContentLoaded', () => {
		initApp();
	});
</script>

<style>
	.game-layout {
		width: 100%;
		min-height: calc(100vh - 200px);
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: flex-start;
		padding-bottom: 24px;
	}

	.seo-guide-container {
		width: 100%;
		max-width: 900px;
		padding: 2.5rem 1rem 1rem 1rem;
		display: flex;
		flex-direction: column;
		gap: 2rem;
	}

	.seo-card {
		padding: 2.25rem 2rem;
		border-radius: var(--radius-lg);
		background: rgba(30, 41, 59, 0.7);
		border: 1px solid var(--border-color);
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
	}

	.seo-header {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
		border-bottom: 1px solid var(--border-color);
		padding-bottom: 1.25rem;
	}

	.badge {
		align-self: flex-start;
		padding: 4px 12px;
		background: var(--player1-bg);
		color: var(--player1-color);
		border: 1px solid var(--border-glow);
		border-radius: var(--radius-full);
		font-size: 0.75rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.5px;
	}

	.seo-header h2 {
		font-size: 1.65rem;
		font-weight: 800;
		color: #ffffff;
		letter-spacing: -0.5px;
		line-height: 1.25;
	}

	.seo-subtitle {
		font-size: 0.95rem;
		line-height: 1.65;
		color: var(--text-muted);
	}

	.seo-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
		gap: 1.25rem;
	}

	.seo-step-card {
		background: rgba(255, 255, 255, 0.03);
		border: 1px solid var(--border-color);
		border-radius: var(--radius-md);
		padding: 1.25rem;
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		position: relative;
	}

	.step-badge {
		width: 28px;
		height: 28px;
		border-radius: var(--radius-full);
		background: var(--player1-color);
		color: #0f172a;
		font-weight: 800;
		font-size: 0.85rem;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.seo-step-card h3 {
		font-size: 1.05rem;
		font-weight: 700;
		color: #ffffff;
	}

	.seo-step-card p {
		font-size: 0.875rem;
		line-height: 1.55;
		color: var(--text-muted);
	}

	.seo-quick-links {
		display: flex;
		flex-wrap: wrap;
		gap: 10px;
		margin-top: 0.5rem;
	}

	.btn-outline {
		display: inline-flex;
		align-items: center;
		padding: 8px 14px;
		border-radius: var(--radius-md);
		background: rgba(255, 255, 255, 0.04);
		border: 1px solid var(--border-color);
		color: var(--text-main);
		font-size: 0.875rem;
		font-weight: 600;
		text-decoration: none;
		transition: all var(--transition-fast);
	}

	.btn-outline:hover {
		background: var(--bg-surface-hover);
		border-color: var(--player1-color);
		color: var(--player1-color);
	}

	.features-summary-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
		gap: 1rem;
	}

	.feature-box {
		background: rgba(255, 255, 255, 0.02);
		border: 1px solid var(--border-color);
		border-radius: var(--radius-md);
		padding: 1.15rem;
		display: flex;
		flex-direction: column;
		gap: 0.4rem;
	}

	.feat-icon {
		font-size: 1.5rem;
	}

	.feature-box h4 {
		font-size: 0.95rem;
		font-weight: 700;
		color: #ffffff;
	}

	.feature-box p {
		font-size: 0.825rem;
		line-height: 1.5;
		color: var(--text-muted);
	}

	.seo-faq-section {
		display: flex;
		flex-direction: column;
		gap: 1rem;
		border-top: 1px solid var(--border-color);
		padding-top: 1.25rem;
	}

	.seo-faq-section h3 {
		font-size: 1.2rem;
		font-weight: 700;
		color: #ffffff;
	}

	.faq-accordion {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
	}

	.faq-item {
		background: rgba(255, 255, 255, 0.03);
		border: 1px solid var(--border-color);
		border-radius: var(--radius-md);
		padding: 0.875rem 1.15rem;
		transition: background var(--transition-fast);
	}

	.faq-item[open] {
		background: rgba(255, 255, 255, 0.05);
	}

	.faq-item summary {
		font-weight: 600;
		font-size: 0.925rem;
		color: var(--text-main);
		cursor: pointer;
		user-select: none;
		outline: none;
	}

	.faq-item summary:hover {
		color: var(--player1-color);
	}

	.faq-item p {
		margin-top: 0.75rem;
		font-size: 0.875rem;
		line-height: 1.6;
		color: var(--text-muted);
	}

	@media (max-width: 768px) {
		.game-layout {
			padding-bottom: 12px;
			min-height: auto;
		}

		.seo-guide-container {
			padding: 1.5rem 0.75rem;
		}

		.seo-card {
			padding: 1.5rem 1.15rem;
		}

		.seo-header h2 {
			font-size: 1.35rem;
		}

		.seo-quick-links {
			flex-direction: column;
		}

		.btn-outline {
			width: 100%;
			justify-content: center;
		}
	}
</style>
